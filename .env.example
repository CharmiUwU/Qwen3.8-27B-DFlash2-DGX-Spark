# Qwen3.8-27B + DFlash2 on one NVIDIA DGX Spark.
#
# Copy once:
#   cp .env.example .env
#
# Shell environment variables take precedence over values in .env.

# Exact runtime validated by this recipe. A different image is rejected unless
# ALLOW_UNVALIDATED_IMAGE=1 is set explicitly.
SGLANG_IMAGE=lmsysorg/sglang@sha256:febfb971c7352570fc445c466ebd6ffc9d896024958e544a60f2137fd85856b1
ALLOW_UNVALIDATED_IMAGE=0

# Exact target and DFlash2 draft revisions used for the published results.
TARGET_MODEL=RadixArk/Qwen3.8-27B-NVFP4
TARGET_REVISION=554ebba9b5f1b79dc11246341960360e6ef05ef4
DFLASH2_MODEL=z-lab/Qwen3.8-27B-DFlash2
DFLASH2_REVISION=50307d4c4cde6860d4eee73e2547cd786fe8e8a4
SERVED_MODEL_NAME=qwen3.8-27b-sglang

# API bind. Use API_BASE=http://HEAD_IP:8888/v1 with the client scripts when
# calling from another machine.
HOST=0.0.0.0
PORT=8888

# This DFlash2 lane is validated at the model's native context only.
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
CHUNKED_PREFILL=8192
MEM_FRACTION_STATIC=0.90

# DGX Spark has ten Cortex-X5 performance cores at 5-9,15-19. Empty disables
# Docker CPU affinity.
CPUSET=5-9,15-19

# DFlash2 requires mamba radix strategy extra_buffer. The recipe derives the
# pool as requests x (5 - MAMBA_SKIP_DECODE_LOCK), so the default is 50 slots.
MAMBA_SKIP_DECODE_LOCK=0

# Keep explicit lifecycle control by default. Docker also accepts on-failure,
# always, and unless-stopped.
RESTART_POLICY=no

# Optional cache locations. Defaults are repo-local and git-ignored.
#HF_CACHE=/absolute/path/to/huggingface-cache
#TRITON_CACHE=/absolute/path/to/triton-cache

# Optional Hugging Face token. Prefer exporting it in your shell instead of
# saving it here. Never commit the real .env file.
#HF_TOKEN=hf_...

# Advanced: extra SGLang flags appended last. The supported defaults above are
# intentionally conservative; changes here are outside the validated profile.
#DFLASH2_EXTRA=

# Advanced: skip local overlay checksum verification before launch.
#SKIP_OVERLAY_VERIFY=0
